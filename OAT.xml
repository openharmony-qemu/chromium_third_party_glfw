<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="compatibility" name="LGPLStyleLicense" path=".*" desc="" />
                <policyitem type="compatibility" name="zlib-acknowledgement" path=".*" desc="" />
                <policyitem type="compatibility" name="Alexander Chemeris" path="deps.*" desc="" />
                <policyitem type="compatibility" name="Khronos Group" path="deps.*" desc="" />
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultPolicyFilter"
                desc="Filters for compatibility,license header policies">
                <filteritem type="filepath" name="third_party/llvm-10.0/llvm/include/llvm/Support/LICENSE.TXT"
                    desc="" />
                <filteritem type="filepath" name="third_party/SPIRV-Tools/BUILD.bazel"
                    desc="" />
                <filteritem type="filepath" name="third_party/llvm-subzero/LICENSE.TXT"
                    desc="" />
                <filteritem type="filepath" name="third_party/subzero/LICENSE.TXT"
                    desc="" />
                <filteritem type="filepath" name="third_party/subzero/bloat/README.chromium"
                    desc="" />
                <filteritem type="filepath" name="third_party/llvm-10.0/Android.bp"
                    desc="" />
                <filteritem type="filepath" name="third_party/SPIRV-Headers/BUILD.bazel"
                    desc="" />
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                <filteritem type="filepath" name="deps/nuklear.h"
                    desc="" />
                <filteritem type="filepath" name="docs/compile.dox"
                    desc="" />
                <filteritem type="filepath" name="docs/main.dox"
                    desc="" />
                </filefilter>
                <filefilter name="defaultFilter">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
            </filefilter> 
        </filefilterlist>
        <licensematcherlist>
            <licensematcher name="Alexander Chemeris" desc="">
                <licensetext name="
                //  Copyright (c) 2006-2008 Alexander Chemeris
            " desc="" />
            </licensematcher>.
            <licensematcher name="Khronos Group" desc="">
                <licensetext name="
                ** Copyright (c) 2008-2018 The Khronos Group Inc
            " desc="" />
            </licensematcher>
        </licensematcherlist>
    </oatconfig>
</configuration>